<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Account</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <h3 class="text-3xl mb-5">Login to Your Account</h3>
    <form action="/login" method="post" class="flex flex-col gap-4 w-1/3">
      <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="email" placeholder="Email" name="email" required>
      <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="password" placeholder="Password" name="password" required>
      <input class="px-5 py-2 rounded-md bg-blue-500" type="submit" value="Login">
    </form>
  </div>
</body>
</html>